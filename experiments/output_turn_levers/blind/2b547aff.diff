+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+
+    # Lowercase conversion
+    assert slugify("HELLO WORLD") == "hello-world"
+    assert slugify("MiXeD CaSe TeXt") == "mixed-case-text"
+
+    # Replace runs of special characters with single hyphen
+    assert slugify("foo...bar") == "foo-bar"
+    assert slugify("foo!!!bar???bar@@@bar") == "foo-bar-bar-bar"
+    assert slugify("foo---bar___bar^^^bar") == "foo-bar-bar-bar"
+
+    # Strip leading hyphens
+    assert slugify("---hello world") == "hello-world"
+    assert slugify("--foo--bar") == "foo-bar"
+    assert slugify("-test-") == "test"
+
+    # Strip trailing hyphens
+    assert slugify("hello world---") == "hello-world"
+    assert slugify("foo...bar---") == "foo-bar"
+    assert slugify("---") == ""
+    assert slugify("-") == ""
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Single characters
+    assert slugify("a") == "a"
+    assert slugify("!") == ""
