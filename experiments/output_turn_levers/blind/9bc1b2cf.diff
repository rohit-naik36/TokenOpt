+def test_slugify():
+    # Basic lowercasing
+    assert slugify("Hello World") == "hello-world"
+    # Replace multiple non-ASCII/non-digit chars with single hyphen
+    assert slugify("Hello... World!") == "hello-world"
+    assert slugify("Test@#123") == "test-123"
+    # Strip leading hyphens
+    assert slugify("--- hello ---") == "hello"
+    # Strip trailing hyphens
+    assert slugify("world---") == "world"
+    # Combined: lowercase, replace runs, strip
+    assert slugify("   Hello... World!   ") == "hello-world"
+    # Empty string becomes empty
+    assert slugify("") == ""
+    # Only special chars becomes empty after stripping
+    assert slugify("---!!!") == ""
