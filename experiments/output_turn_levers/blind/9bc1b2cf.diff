+import re
+
+
+def slugify(text: str) -> str:
+    # Lowercase the text
+    text = text.lower()
+    # Replace runs of non-ASCII letters/digits with single hyphen
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+    # Strip leading and trailing hyphens
+    text = text.strip('-')
+    return text
