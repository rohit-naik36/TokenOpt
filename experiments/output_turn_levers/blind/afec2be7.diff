+
+
+def test_slugify():
+    assert slugify("Hello World!") == "hello-world"
+    assert slugify("Foo-Bar_Baz.test") == "foo-bar-baz-test"
+    # Leading and trailing hyphens are stripped, internal runs become single hyphen
+    assert slugify("---leading dashes---") == "leading-dashes"
+    assert slugify("---trailing dashes") == "trailing-dashes"
+    assert slugify("...multiple spaces...") == "multiple-spaces"
+    assert slugify("") == ""
+    assert slugify("!!!") == ""
+    assert slugify("123") == "123"
+    assert slugify("a-b") == "a-b"
