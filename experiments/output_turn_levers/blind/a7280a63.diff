+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+    # Multiple special chars become single hyphen
+    assert slugify("Hello...World") == "hello-world"
+    # Leading/trailing hyphens stripped
+    assert slugify("--hello-world--") == "hello-world"
+    # Mixed case and special chars
+    assert slugify("TEST!!! 123@#$%") == "test-123"
+    # Single word
+    assert slugify("SingleWord") == "singleword"
+    # Empty string
+    assert slugify("") == ""
+    # Only special chars
+    assert slugify("...---!!!") == ""--- a/textutils.py
