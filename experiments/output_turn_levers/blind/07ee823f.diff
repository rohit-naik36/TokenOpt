+def test_slugify():
+    # Test basic slugification
+    assert slugify("Hello World!") == "hello-world"
+
+    # Test lowercasing
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Test multiple runs of special characters become single hyphen
+    assert slugify("hello---world") == "hello-world"
+    assert slugify("hello...world!!!") == "hello-world"
+
+    # Test mixed special chars in run are treated as one run
+    assert slugify("hello___@#$%world") == "hello-world"
+
+    # Test leading/trailing hyphens stripped
+    assert slugify("-hello-world-") == "hello-world"
+    assert slugify("---test---") == "test"
+
+    # Test empty strings and pure special chars
+    assert slugify("") == ""
+    assert slugify("!!!...???") == ""
+
+    # Test alphanumeric text unchanged (except for case)
+    assert slugify("hello123world456") == "hello123world456"
