+def test_slugify():
+    # Basic slugification with spaces
+    assert slugify("hello world") == "hello-world"
+
+    # Lowercase conversion
+    assert slugify("HELLO World") == "hello-world"
+
+    # Mixed case (underscores are not ASCII letters/digits, so they're replaced)
+    assert slugify("Hello-World_TEST") == "hello-world-test"
+
+    # Replace multiple non-alphanumeric chars with single hyphen
+    assert slugify("hello!!!world@home") == "hello-world-home"
+
+    # Run of special characters becomes single hyphen
+    assert slugify("hello   world--test") == "hello-world-test"
+
+    # Strip leading hyphens
+    assert slugify("---hello---") == "hello"
+
+    # Strip trailing hyphens
+    assert slugify("hello---world---") == "hello-world"
+
+    # Combined: leading/trailing stripped, internal collapsed
+    assert slugify("--hello...!!!---") == "hello"
+
+    # Empty string and edge cases
+    assert slugify("") == ""
+
+    # Only special characters
+    assert slugify("!!!@@@###") == ""
+
+    # Numbers are preserved, underscores replaced (they're not ASCII letters or digits)
+    assert slugify("file_2024_v1.0") == "file-2024-v1-0"
+
+    # Single character
+    assert slugify("a") == "a"
+
+    # Single special char becomes empty after strip
+    assert slugify("---") == ""
+
+    # ASCII letters and digits are kept
+    assert slugify("test123ABC") == "test123abc"
+
+    # Special characters in different positions (underscores also replaced, trailing hyphen stripped)
+    assert slugify("_underscore-") == "underscore"
