+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text and replaces every run of non-ASCII letters or digits
+    with a single hyphen. Strips leading and trailing hyphens.
+    """
+    import re
+    # Lowercase the text
+    result = text.lower()
+    # Replace runs of non-ASCII letters/digits with a single hyphen
+    result = re.sub(r'[^a-z0-9]+', '-', result)
+    # Strip leading and trailing hyphens
+    result = result.strip('-')
+    return result
