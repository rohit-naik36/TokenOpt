+import re
+
+
+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces runs of non-ASCII letters/digits with a single hyphen,
+    and strips leading/trailing hyphens.
+
+    Args:
+        text: The text to convert to a slug.
+
+    Returns:
+        A URL-friendly slug containing only ASCII letters, digits, and hyphens.
+    """
+    # Lowercase the text
+    result = text.lower()
+    # Replace any run of non-ASCII letters or digits with a single hyphen
+    result = re.sub(r'[^a-z0-9]+', '-', result)
+    # Strip leading and trailing hyphens
+    result = result.strip('-')
+    return result
