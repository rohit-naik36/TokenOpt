+def test_slugify_lowercase():
+    """Test that slugify lowercases the input."""
+    assert slugify("Hello World") == "hello-world"
+
+
+def test_slugify_replace_non_alnum():
+    """Test that runs of non-ASCII letters/digits are replaced with single hyphens."""
+    # Multiple spaces, tabs, punctuation should become single hyphen
+    assert slugify("Hello   World!") == "hello-world"
+    assert slugify("Hello\n\tWorld") == "hello-world"
+    assert slugify("Hello, World! (Test)") == "hello-world-test"
+
+
+def test_slugify_strip_leading_hyphens():
+    """Test that leading hyphens are stripped."""
+    assert slugify("-hello world-") == "hello-world"
+    assert slugify("---hello---world---") == "hello-world"
+
+
+def test_slugify_strip_trailing_hyphens():
+    """Test that trailing hyphens are stripped."""
+    assert slugify("hello world--") == "hello-world"
+    assert slugify("hello world- ---") == "hello-world"
+
+
+def test_slugify_empty_string():
+    """Test that empty strings are handled correctly."""
+    assert slugify("") == ""
+    assert slugify("   ") == ""
+    assert slugify("---") == ""
+
+
+def test_slugify_already_slugified():
+    """Test that already slugified text is returned unchanged (after lowercasing)."""
+    assert slugify("hello-world") == "hello-world"
+
+
+def test_slugify_unicode_to_ascii():
+    """Test that unicode characters are replaced with hyphens."""
+    # é, è, à are not ASCII letters, so they become hyphens
+    assert slugify("café résumé naïve") == "caf-r-sum-na-ve"
