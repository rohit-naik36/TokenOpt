+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of non-ASCII letters or digits
+    with a single hyphen, and strips leading/trailing hyphens.
+    """
+    # Lowercase
+    slug = text.lower()
+    # Replace runs of non-ASCII letters/digits with hyphens
+    import re
+    slug = re.sub(r'[^a-z0-9]+', '-', slug)
+    # Strip leading/trailing hyphens
+    slug = slug.strip('-')
+    return slug
