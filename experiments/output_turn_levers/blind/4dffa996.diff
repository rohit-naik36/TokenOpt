+def test_slugify():
+    assert slugify("Hello World!") == "hello-world"
+    assert slugify("FooBar baz---test") == "foobar-baz-test"
+    assert slugify("--- Leading Hyphens") == "leading-hyphens"
+    assert slugify("Trailing---") == "trailing"
+    assert slugify("---") == ""
+    assert slugify("Hello123World") == "hello123world"
