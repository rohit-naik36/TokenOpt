+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug."""
+    import re
+    # Lowercase and replace non-ASCII alphanumeric characters with hyphens
+    slug = text.lower()
+    slug = re.sub(r"[^a-z0-9]+", "-", slug)
+    # Strip leading and trailing hyphens
+    return slug.strip("-")
