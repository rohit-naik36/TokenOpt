+def test_slugify():
+    # Basic lowercase
+    assert slugify("Hello World") == "hello-world"
+
+    # Replace runs of special chars with single hyphen (not multiple)
+    assert slugify("Hello!!! World... Test") == "hello-world-test"
+
+    # Strip leading/trailing hyphens
+    assert slugify("--hello-world--") == "hello-world"
+    assert slugify("---") == ""
+    assert slugify("---hello---world---") == "hello-world"
+
+    # ASCII letters and digits are preserved
+    assert slugify("test123 ABC") == "test123-abc"
+
+    # Mixed content with various separators
+    assert slugify("some-mixed!@#$%^&*()_+content?/:") == "some-mixed-content"
