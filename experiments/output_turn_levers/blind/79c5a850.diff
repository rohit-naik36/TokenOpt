+def test_slugify():
+    assert slugify("Hello World!") == "hello-world"
+    assert slugify("Hello...World") == "hello-world"
+    assert slugify("--leading-dashes--") == "leading-dashes"
+    assert slugify("trailing-hyphen-") == "trailing-hyphen"
+    assert slugify("---") == ""
+    # é is not an ASCII letter, so it gets replaced with a hyphen
+    assert slugify("Café au Lait!") == "caf-au-lait"
