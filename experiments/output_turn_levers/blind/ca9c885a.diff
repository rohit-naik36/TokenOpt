+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+    # Multiple spaces/chars become single hyphen
+    assert slugify("Hello   World") == "hello-world"
+    # Leading/trailing hyphens stripped
+    assert slugify("-Hello World-") == "hello-world"
+    # Only hyphens stripped completely
+    assert slugify("--") == ""
+    # Mixed non-ASCII chars in a run
+    assert slugify("foo...bar!!!baz") == "foo-bar-baz"
