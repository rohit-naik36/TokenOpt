+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Lowercasing
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Multiple consecutive non-alphanumeric chars become single hyphen
+    assert slugify("Hello!!! World... Test") == "hello-world-test"
+
+    # Existing hyphens (non-alphanumeric) are also replaced with hyphens
+    # So 'foo-bar_baz.qux!test@test.com' becomes 'foo-bar-baz-qux-test-test-com'
+    assert slugify("foo-bar_baz.qux!test@test.com") == "foo-bar-baz-qux-test-test-com"
+
+    # Leading special characters are stripped
+    assert slugify("---Hello World---") == "hello-world"
+
+    # Leading/trailing spaces (non-alphanumeric) become hyphens and get stripped
+    assert slugify("  Hello World  ") == "hello-world"
+
+    # Only special characters results in empty string
+    assert slugify("@@@!!!###") == ""
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Text with numbers
+    assert slugify("Version 1.2.3 Released") == "version-1-2-3-released"
+
+    # Mixed case with special chars (underscore is also replaced with hyphen)
+    assert slugify("Hello-World_Test/Path:File") == "hello-world-test-path-file"
