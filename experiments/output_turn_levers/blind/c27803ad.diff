+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercase the text, replace every run of non-ASCII-alphanumeric characters
+    with a single hyphen, and strip leading/trailing hyphens.
+    """
+    import re
+
+    # Lowercase
+    text = text.lower()
+
+    # Replace runs of non-ASCII letters/digits with a single hyphen
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+
+    # Strip leading and trailing hyphens
+    text = text.strip('-')
+
+    return text
