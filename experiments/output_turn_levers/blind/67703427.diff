+
+def test_slugify():
+    # Basic slugify: lowercases and adds hyphens for non-alphanumeric
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple consecutive non-alphanumeric chars become single hyphen
+    assert slugify("Hello...World") == "hello-world"
+    assert slugify("Hello   World!!!") == "hello-world"
+
+    # Leading/trailing hyphens are stripped
+    assert slugify("-Hello World-") == "hello-world"
+    assert slugify("---test---") == "test"
+
+    # Already clean text
+    assert slugify("test123") == "test123"
+
+    # Mixed special characters
+    assert slugify("Hello @#$%^&*() World!") == "hello-world"
