+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple consecutive non-ASCII chars become single hyphen
+    assert slugify("Hello!!!   World") == "hello-world"
+
+    # Leading/trailing hyphens are stripped
+    assert slugify("---Hello---World---") == "hello-world"
+
+    # Text with only non-ascii chars results in empty string (all hyphens stripped)
+    assert slugify("!@#$%") == ""
+    assert slugify("---") == ""
+
+    # Mixed case and special chars
+    assert slugify("Uppercase MIXEd!!!") == "uppercase-mixed"
