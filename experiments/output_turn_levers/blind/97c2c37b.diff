+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+    # Multiple consecutive non-alnum chars become single hyphen
+    assert slugify("Hello!!!   World...") == "hello-world"
+    # Leading/trailing hyphens stripped
+    assert slugify("--Hello--World--") == "hello-world"
+    # Text with numbers
+    assert slugify("v2.0 release") == "v2-0-release"
+    # Punctuation at start/end stripped
+    assert slugify("---Test---") == "test"
+    # Empty text becomes empty string
+    assert slugify("") == ""
+    # Already clean text
+    assert slugify("clean-text") == "clean-text"
