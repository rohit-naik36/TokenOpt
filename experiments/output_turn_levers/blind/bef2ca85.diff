+def test_slugify():
+    # Basic lowercase
+    assert slugify("Hello World") == "hello-world"
+    # Multiple consecutive special chars -> single hyphen
+    assert slugify("Hello!!!World...Test") == "hello-world-test"
+    # Run of non-ASCII letters/digits replaced with single hyphen
+    assert slugify("Hello!!!   World...Test") == "hello-world-test"
+    # Strips leading hyphens
+    assert slugify("---Hello World---") == "hello-world"
+    # Strips trailing hyphens
+    assert slugify("Hello World ---") == "hello-world"
+    # Empty string
+    assert slugify("") == ""
+    # Only special chars
+    assert slugify("---!!!") == ""
+    # Mixed case with numbers
+    assert slugify("Hello123World!") == "hello123world"
