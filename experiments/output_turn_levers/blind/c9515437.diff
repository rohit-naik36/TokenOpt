+def test_slugify():
+    # Basic case
+    assert slugify("Hello World") == "hello-world"
+
+    # Lowercase conversion
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Mixed case
+    assert slugify("HeLLo WoRLd") == "hello-world"
+
+    # Run of special characters becomes single hyphen
+    assert slugify("Hello---World") == "hello-world"
+
+    # Multiple runs become single hyphen each
+    assert slugify("Hello___-World...!") == "hello-world"
+
+    # Strip leading hyphens
+    assert slugify("-Hello World") == "hello-world"
+
+    # Strip trailing hyphens
+    assert slugify("Hello World-") == "hello-world"
+
+    # Both leading and trailing hyphens stripped
+    assert slugify("---Hello World---") == "hello-world"
+
+    # Text with numbers
+    assert slugify("Hello123World") == "hello123world"
+
+    # Run of numbers is preserved (numbers are ASCII digits)
+    assert slugify("Hello___123___World") == "hello-123-world"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Only special characters (all become hyphens, then stripped)
+    assert slugify("!!!---???") == ""
+
+    # Special chars with letters in middle
+    assert slugify("!!Hello!!!") == "hello"
