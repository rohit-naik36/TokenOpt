+def test_slugify():
+    assert slugify("Hello World") == "hello-world"
+    assert slugify("HELLO-WORLD!") == "hello-world"
+    assert slugify("foo...bar") == "foo-bar"
+    assert slugify("foo___bar---baz!!!") == "foo-bar-baz"
+    assert slugify("-hello world-") == "hello-world"
+    assert slugify("---") == ""
+    assert slugify("HelloWorld123") == "helloworld123"
