+def test_slugify():
+    # Test basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Test with multiple spaces (should become single hyphen)
+    assert slugify("Hello   World") == "hello-world"
+
+    # Test with punctuation
+    assert slugify("Hello, World!") == "hello-world"
+
+    # Test with mixed special characters
+    assert slugify("Hello@World#Test$") == "hello-world-test"
+
+    # Test leading/trailing spaces
+    assert slugify("  Hello World  ") == "hello-world"
+
+    # Test leading/trailing hyphens are stripped
+    assert slugify("-Hello- World-") == "hello-world"
+
+    # Test already slug-like input
+    assert slugify("hello-world") == "hello-world"
+
+    # Test empty string
+    assert slugify("") == ""
+
+    # Test text with only special characters
+    assert slugify("---   !!!   ---") == ""
+
+    # Test case insensitivity
+    assert slugify("HELLO WORLD") == "hello-world"
+    assert slugify("HeLLo WoRLd") == "hello-world"
