+def test_slugify():
+    assert slugify("Hello World") == "hello-world"
+    assert slugify("Python 3.11 Release Notes!!!") == "python-3-11-release-notes"
+    assert slugify("---Leading Hyphens---") == "leading-hyphens"
+    assert slugify("---Trailing Hyphens---") == "trailing-hyphens"
+    assert slugify("---Both Hyphens---") == "both-hyphens"
+    assert slugify("Multiple   Spaces   And Tabs") == "multiple-spaces-and-tabs"
+    assert slugify("123 Numbers and ABC letters") == "123-numbers-and-abc-letters"
