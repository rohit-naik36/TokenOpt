+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple spaces become single hyphen
+    assert slugify("Hello   World") == "hello-world"
+
+    # Various non-alphanumeric characters replaced by single hyphen
+    assert slugify("Hello...World!") == "hello-world"
+
+    # Leading/trailing hyphens stripped
+    assert slugify("-Hello-World-") == "hello-world"
+    assert slugify("--hello--world--") == "hello-world"
+
+    # Already lowercase with no special chars
+    assert slugify("simple-slug") == "simple-slug"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Text with numbers
+    assert slugify("Test123-String456") == "test123-string456"
+
+    # Mixed special characters at start and end
+    assert slugify("---hello---world---") == "hello-world"
+
+    # Unicode/emojis treated as non-ASCII (not in a-z0-9, so stripped)
+    # Spaces around emoji are part of the same run
+    assert slugify("Hello 🎉 World") == "hello-world"
+    # Only the first emoji-run at start becomes leading hyphen which gets stripped
+    assert slugify("🎉 Hello") == "hello"
+
+    # Single character edge cases
+    assert slugify("-") == ""
+    assert slugify("---") == ""
+
+    # Only letters
+    assert slugify("abc") == "abc"
