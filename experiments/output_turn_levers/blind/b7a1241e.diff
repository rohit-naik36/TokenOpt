+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple consecutive non-alphanumeric chars become one hyphen
+    assert slugify("Hello   World") == "hello-world"
+    assert slugify("Hello...World") == "hello-world"
+    assert slugify("Hello!@#World") == "hello-world"
+
+    # Only non-alphanumeric at start/end stripped
+    assert slugify("-Hello World-") == "hello-world"
+    assert slugify("...Hello World...") == "hello-world"
+
+    # Already clean text
+    assert slugify("simple-slug") == "simple-slug"
+
+    # Empty and whitespace
+    assert slugify("") == ""
+    # Whitespace-only becomes hyphen then stripped to empty
+    assert slugify("   ") == ""
+    assert slugify("---") == ""
+
+    # Non-ASCII letters are replaced with hyphens (only ASCII a-z preserved)
+    assert slugify("héllo wörld") == "h-llo-w-rld"
+
+    # Mixed alphanumeric and special
+    assert slugify("Test123!@#Test") == "test123-test"
