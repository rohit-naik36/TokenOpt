+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces runs of non-ASCII letters/digits with hyphens,
+    and strips leading/trailing hyphens.
+    """
+    import re
+
+    # Lowercase the text
+    text = text.lower()
+
+    # Replace runs of non-ASCII letters or digits with a single hyphen
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+
+    # Strip leading and trailing hyphens
+    text = text.strip("-")
+
+    return text