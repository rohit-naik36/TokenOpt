+def test_slugify():
+    # Test basic lowercasing and separator replacement
+    assert slugify("Hello World") == "hello-world"
+
+    # Test multiple consecutive non-alphanumeric characters become single hyphen
+    assert slugify("Hello!! World...!!!") == "hello-world"
+
+    # Test runs of special characters
+    assert slugify("C++ Programming!") == "c-programming"
+
+    # Test leading/trailing whitespace becomes hyphens then stripped
+    assert slugify("  foo bar  ") == "foo-bar"
+
+    # Test leading and trailing hyphens are stripped
+    assert slugify("---hello---world---") == "hello-world"
+    assert slugify("-foo--bar-") == "foo-bar"
+
+    # Test empty string
+    assert slugify("") == ""
+
+    # Test string with only non-alphanumeric characters
+    assert slugify("!!!...---") == ""
+
+    # Test mixed alphanumeric content
+    assert slugify("Test123!@#User") == "test123-user"
+
+    # Test special character at start/end
+    assert slugify("--Hello World!") == "hello-world"
+
