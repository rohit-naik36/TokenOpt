+
+
+def test_slugify():
+    # Basic lowercase conversion
+    assert slugify("Hello World!") == "hello-world"
+    # Multiple spaces and punctuation should be single hyphen
+    assert slugify("Hello   World!!!") == "hello-world"
+    # Leading/trailing non-ASCII chars become stripped hyphens
+    assert slugify("  Hello...World  ") == "hello-world"
+    # Text with only separators
+    assert slugify("---Hello---") == "hello"
+    # Mixed special characters and numbers
+    assert slugify("@#$123ABC!@#") == "123abc"
