+from textutils import title_case, truncate, slugify
 
 
 def test_title_case():
     assert title_case("hello big world") == "Hello Big World"
 
 
+def test_slugify():
+    # Basic lowercase conversion
+    assert slugify("Hello World!") == "hello-world"
+
+    # Replace runs of non-alphanumeric chars with single hyphen
+    assert slugify("Foo!!! Bar... BAZ__123") == "foo-bar-baz-123"
+
+    # Strip leading and trailing hyphens
+    assert slugify("---leading/trailing---") == "leading-trailing"
+
+    # Multiple consecutive special characters become single hyphen
+    assert slugify("a@#$b") == "a-b"
+
+    # Already slugified text stays same (just lowercased if needed)
+    assert slugify("hello-world_123") == "hello-world-123"
+
+    # Mixed content
+    assert slugify("Some.Text-With_More*Special+Characters!") == "some-text-with-more-special-characters"
+
+
 def test_truncate():
     assert truncate("abcdef", 10) == "abcdef"
     assert truncate("abcdefghij", 6) == "abc..."
