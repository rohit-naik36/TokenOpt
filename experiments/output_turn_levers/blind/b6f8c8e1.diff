+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of non-ASCII-alphanumeric
+    characters with a single hyphen, and strips leading/trailing hyphens.
+    """
+    lower = text.lower()
+    # Replace any run of non-ASCII letters or digits with a hyphen
+    slug_parts = []
+    prev_was_hyphen = True  # Assume start is like being "after" a hyphen for run detection
+    for char in lower:
+        if "a" <= char <= "z" or "0" <= char <= "9":
+            # This is an ASCII letter or digit - it's not part of a non-ASCII run
+            slug_parts.append(char)
+            prev_was_hyphen = False
+        else:
+            # Non-ASCII letter/digit -> treat as a separator, produce hyphen if needed
+            if not prev_was_hyphen and slug_parts:  # Only add hyphen if we had letters
+                slug_parts.append("-")
+            prev_was_hyphen = True
+    return "".join(slug_parts).strip("-")
