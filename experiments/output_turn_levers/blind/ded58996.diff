+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+    # Lowercase
+    assert slugify("HELLO WORLD") == "hello-world"
+    # Runs of non-alphanumeric chars become single hyphen
+    assert slugify("Hello...World!") == "hello-world"
+    assert slugify("Foo---Bar!!") == "foo-bar"
+    # Strips leading hyphens
+    assert slugify("---Hello World") == "hello-world"
+    # Strips trailing hyphens
+    assert slugify("Hello World---") == "hello-world"
+    assert slugify("---Hello World---") == "hello-world"
+    # Mixed alphanumeric (non-ASCII chars treated as separators)
+    assert slugify("Café-Restaurant") == "caf-restaurant"
+    # Empty string and single chars
+    assert slugify("") == ""
+    assert slugify("a") == "a"
+    assert slugify("!!!") == ""  # Only hyphens are stripped completely
