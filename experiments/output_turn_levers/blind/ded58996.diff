+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text and replaces every run of non-ASCII letters or digits
+    with a single hyphen. Leading and trailing hyphens are stripped.
+
+    Args:
+        text: The input text to convert to a slug.
+
+    Returns:
+        A URL-friendly slug consisting of lowercase ASCII letters, digits, and hyphens.
+    """
+    result = text.lower()
+    # Replace runs of non-ASCII letters/digits with hyphens
+    slug = ""
+    prev_was_hyphen = False
+    for char in result:
+        # Check for ASCII letters (a-z) or digits (0-9)
+        if ('a' <= char <= 'z') or ('0' <= char <= '9'):
+            slug += char
+            prev_was_hyphen = False
+        else:
+            if not prev_was_hyphen:
+                slug += "-"
+                prev_was_hyphen = True
+    return slug.strip("-")
