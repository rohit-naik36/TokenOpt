+def test_slugify():
+    # Basic slugification - lowercase and preserve letters/digits
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple special characters become single hyphen (underscore also replaced)
+    assert slugify("foo-bar_baz.test!@#") == "foo-bar-baz-test"
+
+    # Runs of non-ASCII chars collapse to single hyphen
+    assert slugify("hello---world!!!test") == "hello-world-test"
+
+    # Leading/trailing hyphens are stripped
+    assert slugify("---hello world---") == "hello-world"
+
+    # Already clean text
+    assert slugify("simple-text") == "simple-text"
+
+    # Empty string and whitespace-only become empty
+    assert slugify("") == ""
+    assert slugify("   ") == ""
+
+    # Special characters in the middle
+    assert slugify("test@#$%email@domain.com") == "test-email-domain-com"
+
+    # Mix of ASCII letters, digits, and special chars
+    assert slugify("v1.0-release_candidate!") == "v1-0-release-candidate"
