+def test_slugify():
+    # Basic lowercasing
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Replace runs of non-ASCII-alphanumeric with single hyphen
+    assert slugify("Hello... World!") == "hello-world"
+    assert slugify("foo@bar#baz") == "foo-bar-baz"
+    assert slugify("test__double__underscore") == "test-double-underscore"
+
+    # Strip leading hyphens (spaces are also replaced with hyphens)
+    assert slugify("--leading dashes") == "leading-dashes"
+    assert slugify("---multiple---") == "multiple"
+
+    # Strip trailing hyphens
+    assert slugify("trailing----") == "trailing"
+    assert slugify("dash--") == "dash"
+
+    # Combined: leading, trailing, and middle runs
+    assert slugify("--foo...bar--!") == "foo-bar"
+
+    # Already clean text
+    assert slugify("simple-slug") == "simple-slug"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Only special characters (becomes hyphen then stripped)
+    assert slugify("!!!") == ""
+
+    # Mixed case with numbers
+    assert slugify("Test123-Case456!") == "test123-case456"
