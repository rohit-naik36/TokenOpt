+def slugify(text: str) -> str:
+    # lowercase the text
+    text = text.lower()
+    # replace every run of non-ASCII letters or digits with a single hyphen
+    result = []
+    prev_hyphen = False
+    for char in text:
+        if char.isascii() and (char.isalpha() or char.isdigit()):
+            result.append(char)
+            prev_hyphen = False
+        else:
+            if not prev_hyphen:
+                result.append("-")
+                prev_hyphen = True
+    return "".join(result).strip("-")