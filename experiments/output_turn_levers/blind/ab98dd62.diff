+
+
+def test_slugify():
+    # Basic conversion
+    assert slugify("Hello World!") == "hello-world"
+    # Multiple special chars become single hyphen
+    assert slugify("Hello...World!!") == "hello-world"
+    # Run of non-ascii letters/digits
+    assert slugify("Hello---World___Test") == "hello-world-test"
+    # Leading/trailing hyphens stripped
+    assert slugify("-Hello World-") == "hello-world"
+    assert slugify("--Hello--") == "hello"
+    # Already clean text
+    assert slugify("abc123") == "abc123"
+    # Case insensitive
+    assert slugify("HELLO WORLD") == "hello-world"
