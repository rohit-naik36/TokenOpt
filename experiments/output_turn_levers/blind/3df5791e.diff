+def test_slugify():
+    # Basic slugification - lowercasing and replacing non-alphanumeric chars
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple consecutive non-ASCII characters become single hyphen
+    assert slugify("Hello...World") == "hello-world"
+
+    # Runs of special characters are collapsed to one hyphen
+    assert slugify("foo---bar!!!baz") == "foo-bar-baz"
+
+    # Strips leading hyphens
+    assert slugify("---leading dashes") == "leading-dashes"
+
+    # Strips trailing hyphens
+    assert slugify("trailing dashes---") == "trailing-dashes"
+
+    # Strips both leading and trailing hyphens
+    assert slugify("---both---") == "both"
+
+    # Empty string becomes empty after stripping
+    assert slugify("---") == ""
+
+    # Whitespace characters are replaced with hyphen
+    assert slugify("hello   world") == "hello-world"
+
+    # Unicode/non-ASCII letters are replaced with hyphens, then stripped
+    assert slugify("日本語 Hello") == "hello"
+
+    # Digits are preserved
+    assert slugify("version 1.2.3") == "version-1-2-3"
+
+    # Mixed case is lowercased
+    assert slugify("MiXeD CaSe") == "mixed-case"
