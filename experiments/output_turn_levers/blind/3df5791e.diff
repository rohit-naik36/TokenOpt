+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of characters that are not
+    ASCII letters or digits with a single hyphen, and strips leading and
+    trailing hyphens.
+    """
+    text = text.lower()
+    result = re.sub(r'[^a-z0-9]+', '-', text)
+    return result.strip('-')
