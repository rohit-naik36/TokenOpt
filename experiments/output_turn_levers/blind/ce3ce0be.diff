+def test_slugify():
+    # Basic lowercasing
+    assert slugify("Hello World") == "hello-world"
+    # Replace runs of non-ASCII letters/digits with single hyphen
+    assert slugify("Hello   World!") == "hello-world"
+    assert slugify("foo-bar_baz123.test") == "foo-bar-baz123-test"
+    assert slugify("Hello---World") == "hello-world"
+    # Strip leading/trailing hyphens
+    assert slugify("---leading---") == "leading"
+    assert slugify("---Hello---") == "hello"
+    assert slugify("---hello world---") == "hello-world"
+    assert slugify("---") == ""
+    # Empty string
+    assert slugify("") == ""
+    # Text with only non-alphanumeric chars
+    assert slugify("!!!@@@") == ""
