-def test_title_case():
-    assert title_case("hello big world") == "Hello Big World"
+def test_slugify():
+    # Basic case: simple text with spaces
+    assert slugify("hello world") == "hello-world"
+
+    # Lowercase conversion
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple consecutive non-alphanumeric characters become single hyphen
+    assert slugify("hello...world") == "hello-world"
+
+    # Run of non-alphanumeric chars
+    assert slugify("hello!!!@world") == "hello-world"
+
+    # Mixed special chars and numbers
+    assert slugify("hello! 123 world") == "hello-123-world"
+
+    # Leading hyphen stripped
+    assert slugify("-hello-world") == "hello-world"
+
+    # Trailing hyphen stripped
+    assert slugify("hello-world-") == "hello-world"
+
+    # Both leading and trailing hyphens stripped
+    assert slugify("--hello-world--") == "hello-world"
+
+    # Empty input
+    assert slugify("") == ""
+
+    # Only special chars -> empty string after stripping hyphens
+    assert slugify("...!!!") == ""
+
+    # Preserve ASCII letters and digits
+    assert slugify("Test123Case") == "test123case"
 
 
