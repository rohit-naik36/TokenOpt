+def test_slugify():
+    # Basic slugification with punctuation
+    assert slugify("Hello World!") == "hello-world"
+
+    # Lowercasing
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Mixed case and punctuation
+    assert slugify("Hello-World 123!") == "hello-world-123"
+
+    # Multiple consecutive non-alnum chars become single hyphen
+    assert slugify("Hello...   World!!!") == "hello-world"
+
+    # Leading/trailing hyphens are stripped
+    assert slugify("---Hello---World---") == "hello-world"
+
+    # Only special chars with leading/trailing removed
+    assert slugify("...Hello...") == "hello"
+
+    # Already clean text
+    assert slugify("hello world") == "hello-world"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # URL characters preserved
+    assert slugify("test@example.com") == "test-example-com"
+
+    # Numbers in text
+    assert slugify("Version 1.0 Release") == "version-1-0-release"
