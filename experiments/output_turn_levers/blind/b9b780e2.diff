+
+
+def test_slugify():
+    assert slugify("Hello World!") == "hello-world"
+    assert slugify("HELLO...world") == "hello-world"
+    assert slugify("  Hello___World-123  ") == "hello-world-123"
+    assert slugify("---leading---trailing---") == "leading-trailing"
+    assert slugify("---only-hyphens---") == "only-hyphens"
+    assert slugify("a--b") == "a-b"
+    assert slugify("!@#abc def") == "abc-def"
+    assert slugify("") == ""
