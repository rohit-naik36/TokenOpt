+
+def slugify(text: str) -> str:
+    import re
+    # lowercase and replace non-ASCII alphanumerics with hyphens
+    slug = text.lower()
+    slug = re.sub(r"[^a-z0-9]+", "-", slug)
+    # strip leading/trailing hyphens
+    slug = slug.strip("-")
+    return slug
