+def test_slugify():
+    # basic lowercasing
+    assert slugify("Hello World") == "hello-world"
+    # multiple non-ASCII chars collapsed to single hyphen
+    assert slugify("Hello...World!!!") == "hello-world"
+    # leading/trailing non-ASCII stripped
+    assert slugify("---hello---world---") == "hello-world"
+    # empty string
+    assert slugify("") == ""
+    # already clean text
+    assert slugify("a1b2c3") == "a1b2c3"
+    # only special chars
+    assert slugify("!!!---...") == ""
