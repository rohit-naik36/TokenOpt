+def test_slugify():
+    assert slugify("Hello World") == "hello-world"
+    assert slugify("Hello   World!!!") == "hello-world"
+    assert slugify("---leading hyphens---") == "leading-hyphens"
+    assert slugify("---trailing hyphens--") == "trailing-hyphens"
+    assert slugify("---both---") == "both"
+    assert slugify("special!@#$%^&*()chars") == "special-chars"
+    assert slugify("Mixed123Case456") == "mixed123case456"
+    assert slugify("") == ""
