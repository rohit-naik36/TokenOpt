+def test_slugify():
+    # Basic lowercase
+    assert slugify("Hello World") == "hello-world"
+    # Replace runs of non-ASCII letters/digits with single hyphen
+    assert slugify("Hello!!! World...") == "hello-world"  # all special chars become one run
+    assert slugify("Hello!World@#") == "hello-world"
+    # Strip leading hyphens
+    assert slugify("--Hello World--") == "hello-world"
+    assert slugify("---test---") == "test"
+    # Preserve ASCII letters and digits
+    assert slugify("v1.2.3 release notes!") == "v1-2-3-release-notes"
+    assert slugify("Café Restaurant") == "caf-restaurant"  # non-ASCII chars are stripped
+    assert slugify("") == ""
