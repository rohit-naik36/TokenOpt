+
+def slugify(text: str) -> str:
+    import re
+    # Lowercase the text
+    text = text.lower()
+    # Replace every run of non-ASCII letters or digits with a single hyphen
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+    # Strip leading and trailing hyphens
+    return text.strip("-")
