+class TestSlugify:
+    def test_lowercase(self):
+        """Converts text to lowercase."""
+        assert slugify("Hello World") == "hello-world"
+
+    def test_replace_non_alnum(self):
+        """Replaces runs of non-ASCII letters/digits with hyphens."""
+        assert slugify("Hello_World!@#") == "hello-world"
+        assert slugify("Hello...World") == "hello-world"  # Multiple consecutive replaced with single hyphen
+
+    def test_strip_hyphens(self):
+        """Strips leading and trailing hyphens."""
+        assert slugify("-hello-world-") == "hello-world"
+        assert slugify("--hello") == "hello"
+        assert slugify("world--") == "world"
+        assert slugify("---") == ""
+
+    def test_mixed_content(self):
+        """Handles mixed alphanumeric and special characters."""
+        assert slugify("Hello123World!@#456") == "hello123world-456"  # @# is a run, but 456 follows it
+        assert slugify("Test-User_2024:Admin") == "test-user-2024-admin"
