+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of non-ASCII letters/digits with a single hyphen,
+    and strips leading and trailing hyphens.
+    """
+    result = text.lower()
+    # Replace any sequence of non-ASCII letters or digits with a single hyphen
+    import re
+    result = re.sub(r'[^a-zA-Z0-9]+', '-', result)
+    # Strip leading and trailing hyphens
+    return result.strip('-')
