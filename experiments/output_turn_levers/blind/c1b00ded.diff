+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of non-ASCII letters/digits with
+    a single hyphen, and strips leading/trailing hyphens.
+
+    Args:
+        text: The input text string.
+
+    Returns:
+        A URL-friendly slug with only ASCII letters, digits, and hyphens.
+    """
+    text = text.lower()
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+    return text.strip('-')
