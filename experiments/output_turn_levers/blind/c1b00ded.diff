+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+    # Multiple spaces/characters collapse to single hyphen
+    assert slugify("Hello   World!!!") == "hello-world"
+    # Leading/trailing punctuation stripped
+    assert slugify("--Hello--World--") == "hello-world"
+    assert slugify("--- Hello-World ---") == "hello-world"
+    # Only non-letter/digit characters replaced (hyphens too)
+    assert slugify("Test123-User_@#$Name!") == "test123-user-name"
+    # Empty text
+    assert slugify("") == ""
+    # Already clean text
+    assert slugify("already-clean") == "already-clean"
