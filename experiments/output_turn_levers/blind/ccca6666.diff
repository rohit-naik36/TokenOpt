+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+    # Lowercase
+    assert slugify("HELLO WORLD") == "hello-world"
+    # Multiple runs of non-alphanumeric characters become single hyphen
+    assert slugify("Hello...World!!!") == "hello-world"
+    # Runs of spaces, punctuation combined
+    assert slugify("Hello   World") == "hello-world"
+    # Leading/trailing hyphens stripped
+    assert slugify("---Hello---World---") == "hello-world"
+    # Empty string
+    assert slugify("") == ""
+    # String with only special chars
+    assert slugify("!!!...") == ""
+    # ASCII letters and digits preserved
+    assert slugify("abc123def") == "abc123def"
+    # Mixed case with numbers
+    assert slugify("ABC-123!Def") == "abc-123-def"
