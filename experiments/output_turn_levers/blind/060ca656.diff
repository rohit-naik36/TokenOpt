--- a/test_textutils.py
+++ b/test_textutils.py
@@ -1,4 +1,27 @@
-from textutils import title_case, truncate
+from textutils import slugify, title_case, truncate
+
+
+def test_slugify():
+    # Basic lowercasing
+    assert slugify("Hello World") == "hello-world"
+
+    # Run of non-ASCII/non-alphanumeric chars -> single hyphen
+    assert slugify("Hello...World") == "hello-world"
+    assert slugify("Hello..World") == "hello-world"
+    assert slugify("Hello.World") == "hello-world"
+    assert slugify("Hello!@#World") == "hello-world"
+
+    # Mixed alphanumeric runs preserved
+    assert slugify("Hello-World123") == "hello-world123"
+
+    # Leading/trailing hyphens stripped
+    assert slugify("-Hello World-") == "hello-world"
+    assert slugify("---hello---world---") == "hello-world"
+
+    # Empty string and special cases
+    assert slugify("") == ""
+    assert slugify("   ") == ""
+    assert slugify("---") == ""
 
 
