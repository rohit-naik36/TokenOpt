+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Lowercase
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Mixed case
+    assert slugify("Hello-World!") == "hello-world"
+
+    # Multiple consecutive non-word characters become a single hyphen
+    assert slugify("Hello... World!!") == "hello-world"
+
+    # Strips leading/trailing hyphens
+    assert slugify("-hello world-") == "hello-world"
+
+    assert slugify("---hello world---") == "hello-world"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Just special characters
+    assert slugify("!!!@@@") == ""
+
+    # Preserve ASCII letters and digits, remove everything else
+    assert slugify("Test123!@#String") == "test123-string"
