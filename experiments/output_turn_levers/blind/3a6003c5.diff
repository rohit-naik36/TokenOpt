+def test_slugify_lowercase():
+    assert slugify("Hello World") == "hello-world"
+
+
+def test_slugify_replace_non_alphanumeric():
+    assert slugify("Hello...World!") == "hello-world"
+    assert slugify("Hello@#World$Test%") == "hello-world-test"
+
+
+def test_slugify_strip_leading_hyphens():
+    assert slugify("-hello world-") == "hello-world"
+    assert slugify("--hello-world--") == "hello-world"
+
+
+def test_slugify_keep_single_hyphen_between_words():
+    assert slugify("hello   world") == "hello-world"
+    assert slugify("cafe...coom") == "cafe-coom"
+
+
+def test_slugify_empty_and_whitespace():
+    assert slugify("") == ""
+    assert slugify("   ") == ""
