+def test_slugify():
+    # Basic slugification - lowercases and removes special chars
+    assert slugify("Hello World!") == "hello-world"
+
+    # Replace runs of special characters with single hyphen
+    assert slugify("Hello!!! World???") == "hello-world"
+    assert slugify("foo-bar_baz.123") == "foo-bar-baz-123"  # underscore is also replaced
+
+    # Strip leading and trailing hyphens
+    assert slugify("---Hello---") == "hello"
+    assert slugify("---") == ""
+
+    # Multiple consecutive special characters become one hyphen
+    assert slugify("a--bb---ccc") == "a-bb-ccc"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Already clean text
+    assert slugify("simple-text") == "simple-text"
+
+    # Mixed case and special chars - only ASCII letters/digits are kept
+    assert slugify("Café-Restaurant! 2023") == "caf-restaurant-2023"
