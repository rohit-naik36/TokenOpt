+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces every run of non-ASCII letters or digits
+    with a single hyphen, and strips leading/trailing hyphens.
+    """
+    import re
+    text = text.lower()
+    # Replace any character that's not an ASCII letter or digit with a hyphen
+    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text)
+    # Strip leading and trailing hyphens
+    return slug.strip("-")
