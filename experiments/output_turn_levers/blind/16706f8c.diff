+def test_slugify():
+    # Basic lowercase
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple special chars become single hyphen
+    assert slugify("foo!@#bar") == "foo-bar"
+    assert slugify("foo...bar") == "foo-bar"
+    assert slugify("foo__bar") == "foo-bar"
+
+    # Leading/trailing hyphens stripped
+    assert slugify("---hello---") == "hello"
+    assert slugify("hello---") == "hello"
+    assert slugify("---hello") == "hello"
+
+    # Mixed special chars
+    assert slugify("foo! @#bar...baz__") == "foo-bar-baz"
+
+    # ASCII letters and digits preserved
+    assert slugify("ABC123def") == "abc123def"
+
+    # Empty string
+    assert slugify("") == ""
