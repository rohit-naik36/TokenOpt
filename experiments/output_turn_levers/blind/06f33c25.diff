+
+def slugify(text: str) -> str:
+    import re
+    text = text.lower()
+    # Keep only ASCII letters, digits and replace other characters with hyphens
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+    text = text.strip("-")
+    return text
