+def test_slugify():
+    # Lowercase
+    assert slugify("Hello World") == "hello-world"
+    # Replace runs of non-ASCII letters/digits with single hyphen
+    assert slugify("Hello--World!!!") == "hello-world"
+    # Non-ASCII characters (including accented) are treated as separators and replaced
+    assert slugify("Café résumé") == "caf-r-sum"
+    assert slugify("test@example.com") == "test-example-com"
+    # Strip leading/trailing hyphens
+    assert slugify("---Hello---") == "hello"
+    assert slugify("--hello-world--") == "hello-world"
+    # Empty runs between words count as one separator
+    assert slugify("Multiple   Spaces") == "multiple-spaces"
