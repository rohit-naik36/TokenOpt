+def test_slugify():
+    # Test basic slugification
+    assert slugify("Hello World") == "hello-world"
+    # Test with multiple spaces and punctuation (runs become single hyphen)
+    assert slugify("Hello   Hello!!") == "hello-hello"
+    # Test that leading/trailing hyphens are stripped
+    assert slugify("---Hello---") == "hello"
+    # Test empty string
+    assert slugify("") == ""
+    # Test with numbers
+    assert slugify("Hello123World456") == "hello123world456"
+    # Test that multiple runs of special chars become single hyphen
+    assert slugify("foo---bar!!baz...qux") == "foo-bar-baz-qux"
+    # Test mixed case and special chars (dots are also non-alphanumeric)
+    assert slugify("A.B.C-D-E") == "a-b-c-d-e"
+    # Test with spaces at end (should be stripped as non-alphanumeric)
+    assert slugify("hello world ") == "hello-world"
