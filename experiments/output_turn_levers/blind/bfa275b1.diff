+def test_slugify_basic():
+    assert slugify("Hello World") == "hello-world"
+
+
+def test_slugify_special_chars():
+    assert slugify("Hello! How@Are#You") == "hello-how-are-you"
+
+
+def test_slugify_multiple_special_runs():
+    assert slugify("Hello!!!...World----Test") == "hello-world-test"
+
+
+def test_slugify_leading_trailing_hyphens():
+    assert slugify("---Hello---") == "hello"
+    assert slugify("Hello---") == "hello"
+    assert slugify("---Hello") == "hello"
+
+
+def test_slugify_digits():
+    assert slugify("Test123ABC!@#") == "test123abc"
+
+
+def test_slugify_empty_and_whitespace():
+    assert slugify("") == ""
+    assert slugify("   ") == ""
