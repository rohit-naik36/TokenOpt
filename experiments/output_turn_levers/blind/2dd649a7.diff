+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple consecutive special characters become one hyphen
+    assert slugify("Hello...World") == "hello-world"
+
+    # Strip leading/trailing hyphens
+    assert slugify("---Hello World---") == "hello-world"
+    assert slugify("--hello--world--") == "hello-world"
+
+    # Empty text and punctuation only
+    assert slugify("") == ""
+    assert slugify("!!!") == ""
+    assert slugify("---") == ""  # All hyphens are stripped away
+
+    # Keep letters and digits
+    assert slugify("C++ Developer 2024") == "c-developer-2024"
+
+    # Lowercase conversion
+    assert slugify("HELLO WORLD") == "hello-world"
