+def test_slugify():
+    assert slugify("Hello World") == "hello-world"
+    assert slugify("HELLO-WORLD!!!") == "hello-world"
+    assert slugify("FooBar123!") == "foobar123"
+    assert slugify("---test---") == "test"
+    assert slugify("___leading---trailing___") == "leading-trailing"
+    assert slugify("Multiple   Spaces and...Punctuation!!!") == "multiple-spaces-and-punctuation"
