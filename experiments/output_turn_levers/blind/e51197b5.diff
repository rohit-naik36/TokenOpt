+def test_slugify():
+    # Basic slugify - lowercase and replace non-ASCII/non-digit with hyphens
+    assert slugify("Hello World!") == "hello-world"
+
+    # Multiple consecutive special chars become single hyphen
+    assert slugify("Hello...World") == "hello-world"
+    assert slugify("Hello___World") == "hello-world"
+    assert slugify("Hello@@@World") == "hello-world"
+
+    # Mixed runs of special chars (spaces are also non-ASCII/non-digit)
+    assert slugify("Hello!!! ... @@@ World") == "hello-world"
+
+    # Strip leading hyphens
+    assert slugify("---hello world") == "hello-world"
+
+    # Strip trailing hyphens
+    assert slugify("hello world---") == "hello-world"
+
+    # Strip both leading and trailing hyphens
+    assert slugify("---hello world---") == "hello-world"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # Already clean text
+    assert slugify("hello123world") == "hello123world"
+
+    # Single char tests
+    assert slugify("-") == ""
+    assert slugify("!") == ""
+    assert slugify("a") == "a"
+
+    # Numbers preserved
+    assert slugify("test-123") == "test-123"
