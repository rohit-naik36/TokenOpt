+def test_slugify():
+    # Basic lowercasing
+    assert slugify("Hello World") == "hello-world"
+
+    # Replace runs of non-alphanumeric with single hyphen
+    assert slugify("Foo---Bar!!!") == "foo-bar"
+    assert slugify("test...string...here") == "test-string-here"
+
+    # Strip leading hyphens
+    assert slugify("---hello") == "hello"
+
+    # Strip trailing hyphens
+    assert slugify("world---") == "world"
+
+    # Strip both leading and trailing hyphens
+    assert slugify("---hello---") == "hello"
+
+    # Empty string and punctuation only
+    assert slugify("") == ""
+    assert slugify("!!!") == ""
+
+    # Numbers should be preserved
+    assert slugify("Test123String") == "test123string"
