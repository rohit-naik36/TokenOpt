+def test_slugify_multiple_separators():
+    assert slugify("Hello...   World!!!") == "hello---world".replace("---", "-")
+
+
+def test_slugify_strip_leading_hyphens():
+    assert slugify("-Hello World-") == "hello-world"
+
+
+def test_slugify_strip_trailing_hyphens():
+    assert slugify("Hello World-") == "hello-world"
+
+
+def test_slugify_keep_letters_digits():
+    assert slugify("Test123!") == "test123"
