 """Small text helpers used by the CLI."""
+
+
+def slugify(text: str) -> str:
+    """Convert text to a URL-friendly slug.
+
+    Lowercases the text, replaces runs of non-ASCII-non-alphanumeric chars with a single hyphen,
+    and strips leading/trailing hyphens.
+    """
+    import re
+
+    # Lowercase
+    text = text.lower()
+
+    # Replace any run of non-ASCII letters or digits with a hyphen
+    text = re.sub(r"[^a-z0-9]+", "-", text)
+
+    # Strip leading and trailing hyphens
+    text = text.strip("-")
+
+    return text
 
 
