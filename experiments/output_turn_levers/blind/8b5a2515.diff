+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple spaces and punctuation become single hyphen
+    assert slugify("Hello   ...World!!!") == "hello-world"
+
+    # Runs of non-alphanumeric chars become single hyphen
+    assert slugify("Hello...World") == "hello-world"
+
+    # Lowercase conversion
+    assert slugify("HELLO WORLD") == "hello-world"
+
+    # Mixed case and special chars
+    assert slugify("Mixed Case! With @#$% Chars") == "mixed-case-with-chars"
+
+    # Leading/trailing hyphens stripped
+    assert slugify("-Hello World-") == "hello-world"
+    assert slugify("--   Hello --  World ---") == "hello-world"
+
+    # Already clean input
+    assert slugify("simple-text") == "simple-text"
+
+    # Single character
+    assert slugify("test") == "test"
+
+    # Empty string
+    assert slugify("") == ""
+
+    # All non-alphanumeric
+    assert slugify("!@#$%") == ""
+
+    # URL path-like input
+    assert slugify("/path/to/resource with spaces/") == "path-to-resource-with-spaces"
