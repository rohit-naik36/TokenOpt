+def test_slugify():
+    # Basic slugification
+    assert slugify("Hello World") == "hello-world"
+
+    # Multiple consecutive non-alphanumeric chars become single hyphen
+    assert slugify("Hello   World!!") == "hello-world"
+
+    # Leading and trailing hyphens are stripped
+    assert slugify("-Hello-World-") == "hello-world"
+
+    # Mixed case with various separators
+    assert slugify("Hello...World!@#Test") == "hello-world-test"
+
+    # Already lowercased with dashes
+    assert slugify("HELLO-WORLD") == "hello-world"
+
+    # Text with numbers
+    assert slugify("My Test123 Post 456") == "my-test123-post-456"
+
+    # Special characters in between text
+    assert slugify("User@Name#123") == "user-name-123"
